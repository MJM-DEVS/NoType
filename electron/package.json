{
  "name": "notype",
  "version": "3.3.0",
  "description": "NoType: Local Voice Dictation (Privacy-First)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never",
    "build:dir": "electron-builder --win --x64 --dir --publish never",
    "check": "node --check main.js && node --check preload.js && node --check model-catalog.js && node --check keycaps.js && node --check sprites.js && node --check lib/settings-file.js && node --check lib/backend-line.js && node --check lib/guards.js && node --check lib/phrase-key.js && node --check lib/model-labels.js && node --check lib/history-file.js && node --check build-resources/fuses.js",
    "test": "node --test"
  },
  "author": "Mijo Jurisic (MJM-DEVS)",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/MJM-DEVS/NoType#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MJM-DEVS/NoType.git"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.notype.app",
    "productName": "NoType",
    "directories": {
      "output": "../dist",
      "buildResources": "build-resources"
    },
    "afterPack": "build-resources/fuses.js",
    "files": [
      "main.js",
      "preload.js",
      "model-catalog.js",
      "keycaps.js",
      "sprites.js",
      "lib/**",
      "*.html",
      "assets/**",
      "!node_modules/electron-builder/**",
      "!node_modules/**/{CHANGELOG.md,README.md,readme.md,*.d.ts,*.map,*.tsbuildinfo}"
    ],
    "extraResources": [
      {
        "from": "../dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "MJM-DEVS",
        "repo": "NoType",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "NoType-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "NoType-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NoType",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "include": "installer.nsh",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
